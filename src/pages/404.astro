---
import Layout from "../layouts/Layout.astro";
import { localizePath, useTranslations } from "../i18n/utils";

// GitHub Pages serves one 404 for every language, so it shows both.
const en = useTranslations("en");
const fr = useTranslations("fr");
---

<Layout
    title={`${en("404.title")} | Léonel VODOUNOU`}
    lang="en"
    langPaths={{ en: localizePath("", "en"), fr: localizePath("", "fr") }}
    translated={false}
>
    <div class="mx-auto flex min-h-[60vh] max-w-xl flex-col items-center justify-center px-4 py-24 text-center">
        <p class="text-sm font-medium tabular-nums text-accent">404</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-fg">{en("404.title")}</h1>
        <p class="mt-3 text-fg-muted">{en("404.text")}</p>
        <p lang="fr" class="mt-6 text-sm text-fg-subtle">{fr("404.title")} · {fr("404.text")}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href={localizePath("", "en")} class="btn-primary">{en("404.back")}</a>
            <a href={localizePath("", "fr")} lang="fr" class="btn-secondary">{fr("404.back")}</a>
        </div>
    </div>
</Layout>

<script is:inline>
    // Script pour corriger automatiquement les anciennes URLs référencées par Google/Bing
    // qui contenaient le sous-dossier "/Portfolio-main/"
    if (window.location.pathname.startsWith("/Portfolio-main")) {
        const newUrl = window.location.pathname.replace("/Portfolio-main", "");
        window.location.replace(newUrl || "/");
    }
</script>
