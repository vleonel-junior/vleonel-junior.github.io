---
import Layout from "../layouts/Layout.astro";
import { experienceData } from "../data/experience";
import { period, tag, tr, useTranslations, type Lang } from "../i18n/utils";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout
    title={t("experience.title")}
    description={t("experience.description")}
    lang={lang}
>
    <main class="pt-20">
        <!-- Hero Section -->
        <section class="container py-12">
            <div class="text-center mb-12">
                <h1 class="heading-1 mb-4">{t("experience.heading")}</h1>
                <p
                    class="body-large max-w-2xl mx-auto text-gray-600 dark:text-gray-400"
                >
                    {t("experience.subtitle")}
                </p>
            </div>
        </section>

        <!-- Timeline -->
        <section class="container pb-16">
            <div class="max-w-4xl mx-auto">
                {
                    experienceData.map((exp) => (
                        <div class="relative border-l-2 border-blue-200 dark:border-blue-800 ml-6 pb-12">
                            <div class="absolute -left-3 bg-blue-500 w-6 h-6 rounded-full border-4 border-white dark:border-gray-900" />
                            <div class="ml-8">
                                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-2">
                                    <h3 class="heading-3 text-blue-600 dark:text-blue-400">
                                        {tr(exp.role, lang)}
                                    </h3>
                                    <span class="text-sm text-gray-500 dark:text-gray-400 font-medium">
                                        {period(exp.startDate, exp.endDate, lang)}
                                    </span>
                                </div>
                                <p class="text-lg font-medium text-gray-700 dark:text-gray-300 mb-3">
                                    {tr(exp.company, lang)}
                                </p>
                                <p class="body-text mb-4">{tr(exp.description, lang)}</p>
                                <div class="flex flex-wrap gap-2">
                                    {exp.technologies.map((tech) => (
                                        <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-full text-sm">
                                            {tag(tech, lang)}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        </div>
                    ))
                }

                <!-- Final dot -->
                <div
                    class="relative border-l-2 border-blue-200 dark:border-blue-800 ml-6"
                >
                    <div
                        class="absolute -left-3 bg-gray-300 dark:bg-gray-600 w-6 h-6 rounded-full border-4 border-white dark:border-gray-900"
                    >
                    </div>
                </div>
            </div>
        </section>

    </main>
</Layout>
