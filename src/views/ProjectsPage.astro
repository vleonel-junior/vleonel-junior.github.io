---
import Layout from "../layouts/Layout.astro";
import { projectsData } from "../data/projects";
import { tag, tr, useTranslations, withBase, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const categoryLabel = (category?: string) =>
  category === "academic" || category === "personal"
    ? t(`category.${category}`)
    : category;
---

<Layout title={t("projects.title")} description={t("projects.description")} lang={lang}>
  <div class="mx-auto w-full max-w-3xl px-4 pb-8 pt-16 sm:px-6 sm:pt-24">
    <h1 class="text-3xl font-semibold tracking-tight text-fg sm:text-4xl">
      {t("projects.heading")}
    </h1>
    <p class="mt-3 text-lg text-fg-muted">{t("projects.subtitle")}</p>

    <div class="mt-12 grid gap-4">
      {
        projectsData.map((project) => (
          <article class="card flex flex-col p-6">
            {project.image && (
              <img
                src={withBase(project.image)}
                alt={tr(project.title, lang)}
                class="mb-5 aspect-[16/9] w-full rounded-lg border border-border object-cover"
                loading="lazy"
              />
            )}
            <div class="flex items-center gap-2 text-sm text-fg-subtle">
              {project.category && <span>{categoryLabel(project.category)}</span>}
              {project.category && project.year && <span aria-hidden="true">·</span>}
              {project.year && <span class="tabular-nums">{project.year}</span>}
            </div>
            <h2 class="mt-1.5 text-xl font-semibold tracking-tight text-fg">
              {tr(project.title, lang)}
            </h2>
            <p class="mt-2 leading-relaxed text-fg-muted">{tr(project.description, lang)}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {project.technologies.map((tech) => (
                <span class="tag">{tag(tech, lang)}</span>
              ))}
            </div>
            {(project.githubUrl || project.liveUrl) && (
              <div class="mt-5 flex gap-4 text-sm">
                {project.githubUrl && (
                  <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="link">
                    {t("home.viewGithub")} ↗
                  </a>
                )}
                {project.liveUrl && (
                  <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="link">
                    Demo ↗
                  </a>
                )}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</Layout>
