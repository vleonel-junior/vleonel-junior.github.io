---
// Page frame shared by blog articles and reading-notes chapters, laid out
// like a Substack post: one reading column, title, subtitle, byline, then the
// text, and the reading map pinned to the left edge.
import type { MarkdownHeading } from "astro";
import Layout from "../layouts/Layout.astro";
import TableOfContents from "./TableOfContents.astro";
import Newsletter from "./Newsletter.astro";
import Comments from "./Comments.astro";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
	lang: Lang;
	title: string;
	description: string;
	image?: string;
	langPaths: Record<Lang, string>;
	translated: boolean;
	headings: MarkdownHeading[];
	showToc?: boolean;
	/** Small label above the title (series and chapter, category...) */
	eyebrow?: string;
	back?: { href: string; label: string };
	author: string;
	date: string;
	readingTime: string;
	/** Short HTML notice shown above the text (source and rights) */
	notice?: string;
}

const {
	lang,
	title,
	description,
	image,
	langPaths,
	translated,
	headings,
	showToc = true,
	eyebrow,
	back,
	author,
	date,
	readingTime,
	notice,
} = Astro.props;

const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
---

<Layout
	title={title}
	description={description}
	image={image}
	type="article"
	lang={lang}
	langPaths={langPaths}
	translated={translated}
>
	<div class="mx-auto w-full max-w-[728px] px-4 pb-8 pt-8 sm:px-0 sm:pt-14">
		{
			back && (
				<a
					href={back.href}
					class="mb-8 inline-flex items-center gap-1.5 text-sm text-fg-subtle transition-colors hover:text-fg"
				>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M19 12H5M12 19l-7-7 7-7" />
					</svg>
					{back.label}
				</a>
			)
		}

		<header>
			{eyebrow && <p class="mb-3 text-sm font-medium text-accent">{eyebrow}</p>}
			<h1 class="article-title">{title}</h1>
			<p class="article-subtitle">{description}</p>

			<div class="mt-6 flex items-center gap-3">
				<img
					src={`${base}images/me_cropped.png`}
					alt=""
					width="40"
					height="40"
					class="h-10 w-10 rounded-full object-cover object-[center_35%]"
				/>
				<div class="text-[0.8125rem] uppercase leading-5 tracking-wide">
					<p class="font-medium text-fg">{author}</p>
					<p class="text-fg-subtle">
						{date} · {readingTime}
					</p>
				</div>
			</div>

			<div class="mt-5 flex items-center justify-between border-y border-border py-3">
				<a
					href="#comments"
					class="inline-flex items-center gap-2 rounded-full border border-border px-3.5 py-1.5 text-sm text-fg-muted transition-colors hover:bg-muted hover:text-fg"
				>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
					</svg>
					{t("post.discuss")}
				</a>
				<button
					type="button"
					data-share
					data-copied={t("post.linkCopied")}
					class="inline-flex items-center gap-2 rounded-full border border-border px-3.5 py-1.5 text-sm text-fg-muted transition-colors hover:bg-muted hover:text-fg"
				>
					{t("post.share")}
				</button>
			</div>
		</header>

		{
			notice && (
				<aside
					class="mt-8 rounded-lg border border-border bg-surface px-4 py-3 text-sm leading-relaxed text-fg-muted [&_a]:text-fg [&_a]:underline [&_a]:decoration-accent/50 [&_a]:underline-offset-2"
					set:html={notice}
				/>
			)
		}

		<article class="article prose mt-8" data-code-blocks data-zoomable>
			<slot />
		</article>

		<dialog class="lightbox" data-lightbox aria-label={lang === "fr" ? "Image agrandie" : "Enlarged image"}>
			<button type="button" class="lightbox-close" data-lightbox-close aria-label={lang === "fr" ? "Fermer" : "Close"}>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M18 6 6 18M6 6l12 12" />
				</svg>
			</button>
			<figure class="lightbox-figure">
				<img alt="" />
				<figcaption></figcaption>
			</figure>
		</dialog>

		<slot name="after" />

		<div id="comments" class="mt-16 scroll-mt-20 border-t border-border pt-12">
			<Newsletter lang={lang} />
			<Comments lang={lang} />
		</div>
	</div>

	{showToc && <TableOfContents headings={headings} lang={lang} />}
</Layout>

<script>
	document.querySelectorAll<HTMLButtonElement>("[data-share]").forEach((button) => {
		button.addEventListener("click", async () => {
			const url = location.href.split("#")[0];
			if (navigator.share) {
				try {
					await navigator.share({ title: document.title, url });
				} catch {}
				return;
			}
			try {
				await navigator.clipboard.writeText(url);
				const label = button.textContent;
				button.textContent = button.dataset.copied ?? "";
				setTimeout(() => (button.textContent = label), 1500);
			} catch {}
		});
	});
</script>

<script is:inline define:vars={{ enlargeLabel: lang === "fr" ? "Agrandir l'image" : "Enlarge image" }}>
	// Opens article images full screen on click (or Enter), with their caption.
	// Closes on any click, the close button or Escape.
	(() => {
		const dialog = document.querySelector("[data-lightbox]");
		if (!dialog) return;
		const big = dialog.querySelector("img");
		const caption = dialog.querySelector("figcaption");

		const open = (img) => {
			big.src = img.currentSrc || img.src;
			big.alt = img.alt;
			// Used on phones only: up to 2.5 screens wide, never beyond the file's own size
			big.style.setProperty("--lightbox-width", `${Math.min(img.naturalWidth || 0, document.documentElement.clientWidth * 2.5) || document.documentElement.clientWidth}px`);
			// Copy the rendered caption, so its formulas stay typeset
			const source = img.closest("figure")?.querySelector("figcaption");
			caption.innerHTML = source ? source.innerHTML : "";
			caption.hidden = !source?.textContent.trim();
			dialog.showModal();
			document.documentElement.classList.add("lightbox-open");
		};

		dialog.addEventListener("close", () => document.documentElement.classList.remove("lightbox-open"));
		dialog.addEventListener("click", () => dialog.close());

		document.querySelectorAll("[data-zoomable] img").forEach((img) => {
			img.classList.add("zoomable");
			img.tabIndex = 0;
			img.setAttribute("role", "button");
			img.setAttribute("aria-label", img.alt ? `${enlargeLabel} (${img.alt})` : enlargeLabel);
			img.addEventListener("click", () => open(img));
			img.addEventListener("keydown", (event) => {
				if (event.key === "Enter" || event.key === " ") {
					event.preventDefault();
					open(img);
				}
			});
		});
	})();
</script>

<script is:inline define:vars={{ copyLabel: lang === "fr" ? "Copier" : "Copy", copiedLabel: lang === "fr" ? "Copié" : "Copied", outputLabel: lang === "fr" ? "Sortie" : "Output" }}>
	// Adds a language label and a copy button to code blocks, and a label to
	// execution outputs. Runs once, after the article is parsed.
	document.querySelectorAll("[data-code-blocks] pre").forEach((pre) => {
		if (pre.parentElement?.classList.contains("code-block")) return;
		const lang = pre.dataset.language || "";
		const isOutput = ["plaintext", "text", "output", ""].includes(lang);

		const wrapper = document.createElement("div");
		wrapper.className = "code-block";
		pre.parentNode.insertBefore(wrapper, pre);
		wrapper.appendChild(pre);

		if (isOutput) {
			const label = document.createElement("span");
			label.className = "code-block-output-label";
			label.textContent = outputLabel;
			wrapper.appendChild(label);
			return;
		}

		const bar = document.createElement("div");
		bar.className = "code-block-bar";
		const langEl = document.createElement("span");
		langEl.className = "code-block-lang";
		langEl.textContent = lang;
		const button = document.createElement("button");
		button.type = "button";
		button.className = "code-block-copy";
		button.textContent = copyLabel;
		button.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(pre.innerText);
				button.textContent = copiedLabel;
				setTimeout(() => (button.textContent = copyLabel), 1500);
			} catch {}
		});
		bar.append(langEl, button);
		wrapper.appendChild(bar);
	});
</script>
