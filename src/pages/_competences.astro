---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Compétences - Léonel VODOUNOU"
    description="Mes compétences techniques et domaines d'expertise en IA et mathématiques"
>
    <main class="pt-20">
        <!-- Hero Section -->
        <section class="container py-12">
            <div class="text-center mb-12">
                <h1 class="heading-1 mb-4">Compétences & Expertise</h1>
                <p
                    class="body-large max-w-2xl mx-auto text-gray-600 dark:text-gray-400"
                >
                    Un aperçu de mes compétences techniques et domaines
                    d'expertise au croisement des mathématiques et de l'IA
                </p>
            </div>
        </section>

        <!-- Core Competencies -->
        <section class="container pb-16">
            <div class="grid gap-8 lg:grid-cols-2">
                <!-- AI & Machine Learning -->
                <div
                    class="bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-sm border"
                >
                    <div class="flex items-center mb-6">
                        <div class="text-4xl mr-4">🧠</div>
                        <h2 class="heading-2">Intelligence Artificielle</h2>
                    </div>
                    <p class="body-text mb-6 text-gray-600 dark:text-gray-400">
                        Expertise approfondie en développement et déploiement de
                        modèles d'IA innovants
                    </p>
                    <div class="space-y-4">
                        <div>
                            <div class="flex justify-between mb-2">
                                <span class="font-medium"
                                    >Deep Learning & Neural Networks</span
                                >
                                <span class="text-sm text-gray-500">95%</span>
                            </div>
                            <div
                                class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full"
                            >
                                <div
                                    class="h-2 bg-blue-500 rounded-full"
                                    style="width: 95%"
                                >
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between mb-2">
                                <span class="font-medium"
                                    >Natural Language Processing</span
                                >
                                <span class="text-sm text-gray-500">90%</span>
                            </div>
                            <div
                                class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full"
                            >
                                <div
                                    class="h-2 bg-blue-500 rounded-full"
                                    style="width: 90%"
                                >
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between mb-2">
                                <span class="font-medium">Computer Vision</span>
                                <span class="text-sm text-gray-500">85%</span>
                            </div>
                            <div
                                class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full"
                            >
                                <div
                                    class="h-2 bg-blue-500 rounded-full"
                                    style="width: 85%"
                                >
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between mb-2">
                                <span class="font-medium"
                                    >Reinforcement Learning</span
                                >
                                <span class="text-sm text-gray-500">80%</span>
                            </div>
                            <div
                                class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full"
                            >
                                <div
                                    class="h-2 bg-blue-500 rounded-full"
                                    style="width: 80%"
                                >
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mathematics -->
                <div
                    class="bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-sm border"
                >
                    <div class="flex items-center mb-6">
                        <div class="text-4xl mr-4">🧮</div>
                        <h2 class="heading-2">Mathématiques Appliquées</h2>
                    </div>
                    <p class="body-text mb-6 text-gray-600 dark:text-gray-400">
                        Fondations mathématiques solides pour une approche
                        rigoureuse de l'IA
                    </p>
                    <div class="space-y-4">
                        <div>
                            <div class="flex justify-between mb-2">
                                <span class="font-medium"
                                    >Probabilités & Statistiques</span
                                >
                                <span class="text-sm text-gray-500">98%</span>
                            </div>
                            <div
                                class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full"
                            >
                                <div
                                    class="h-2 bg-green-500 rounded-full"
                                    style="width: 98%"
                                >
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between mb-2">
                                <span class="font-medium"
                                    >Modélisation Stochastique</span
                                >
                                <span class="text-sm text-gray-500">95%</span>
                            </div>
                            <div
                                class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full"
                            >
                                <div
                                    class="h-2 bg-green-500 rounded-full"
                                    style="width: 95%"
                                >
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between mb-2">
                                <span class="font-medium"
                                    >Optimisation Mathématique</span
                                >
                                <span class="text-sm text-gray-500">92%</span>
                            </div>
                            <div
                                class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full"
                            >
                                <div
                                    class="h-2 bg-green-500 rounded-full"
                                    style="width: 92%"
                                >
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between mb-2">
                                <span class="font-medium"
                                    >Analyse Numérique</span
                                >
                                <span class="text-sm text-gray-500">88%</span>
                            </div>
                            <div
                                class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full"
                            >
                                <div
                                    class="h-2 bg-green-500 rounded-full"
                                    style="width: 88%"
                                >
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Technical Stack -->
        <section class="bg-gray-50 dark:bg-gray-900/50 py-16">
            <div class="container">
                <div class="text-center mb-12">
                    <h2 class="heading-2 mb-4">Stack Technique</h2>
                    <p
                        class="body-large max-w-2xl mx-auto text-gray-600 dark:text-gray-400"
                    >
                        Technologies et outils que j'utilise quotidiennement
                    </p>
                </div>

                <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
                    <!-- Programming Languages -->
                    <div
                        class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border"
                    >
                        <h3 class="heading-3 mb-4 flex items-center">
                            <span class="text-2xl mr-2">💻</span>
                            Langages
                        </h3>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="font-medium">Python</span>
                                <span
                                    class="px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded text-xs"
                                    >Expert</span
                                >
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="font-medium">R</span>
                                <span
                                    class="px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded text-xs"
                                    >Avancé</span
                                >
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="font-medium">Julia</span>
                                <span
                                    class="px-2 py-1 bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 rounded text-xs"
                                    >Intermédiaire</span
                                >
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="font-medium">MATLAB</span>
                                <span
                                    class="px-2 py-1 bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 rounded text-xs"
                                    >Avancé</span
                                >
                            </div>
                        </div>
                    </div>

                    <!-- ML Frameworks -->
                    <div
                        class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border"
                    >
                        <h3 class="heading-3 mb-4 flex items-center">
                            <span class="text-2xl mr-2">🔧</span>
                            Frameworks ML
                        </h3>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="font-medium">PyTorch</span>
                                <span
                                    class="px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded text-xs"
                                    >Expert</span
                                >
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="font-medium">TensorFlow</span>
                                <span
                                    class="px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded text-xs"
                                    >Avancé</span
                                >
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="font-medium">Scikit-learn</span>
                                <span
                                    class="px-2 py-1 bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 rounded text-xs"
                                    >Expert</span
                                >
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="font-medium">Hugging Face</span>
                                <span
                                    class="px-2 py-1 bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 rounded text-xs"
                                    >Avancé</span
                                >
                            </div>
                        </div>
                    </div>

                    <!-- Data & Analytics -->
                    <div
                        class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border"
                    >
                        <h3 class="heading-3 mb-4 flex items-center">
                            <span class="text-2xl mr-2">📊</span>
                            Data & Analytics
                        </h3>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="font-medium">Pandas</span>
                                <span
                                    class="px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded text-xs"
                                    >Expert</span
                                >
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="font-medium">NumPy</span>
                                <span
                                    class="px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded text-xs"
                                    >Expert</span
                                >
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="font-medium"
                                    >Matplotlib/Seaborn</span
                                >
                                <span
                                    class="px-2 py-1 bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 rounded text-xs"
                                    >Avancé</span
                                >
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="font-medium">Plotly</span>
                                <span
                                    class="px-2 py-1 bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 rounded text-xs"
                                    >Avancé</span
                                >
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="font-medium">Excel (BI)</span>
                                <span
                                    class="px-2 py-1 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-200 rounded text-xs"
                                    >Intermédiaire</span
                                >
                            </div>
                        </div>
                    </div>

                    <!-- DevOps & Cloud -->
                    <div
                        class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border"
                    >
                        <h3 class="heading-3 mb-4 flex items-center">
                            <span class="text-2xl mr-2">☁️</span>
                            DevOps & Cloud
                        </h3>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="font-medium">Docker</span>
                                <span
                                    class="px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded text-xs"
                                    >Avancé</span
                                >
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="font-medium">AWS/GCP</span>
                                <span
                                    class="px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded text-xs"
                                    >Intermédiaire</span
                                >
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="font-medium">MLflow</span>
                                <span
                                    class="px-2 py-1 bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 rounded text-xs"
                                    >Avancé</span
                                >
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="font-medium">Git/GitHub</span>
                                <span
                                    class="px-2 py-1 bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 rounded text-xs"
                                    >Expert</span
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Specialized Knowledge -->
        <section class="container py-16">
            <div class="text-center mb-12">
                <h2 class="heading-2 mb-4">Domaines de Spécialisation</h2>
                <p
                    class="body-large max-w-2xl mx-auto text-gray-600 dark:text-gray-400"
                >
                    Mes domaines d'expertise et de recherche privilégiés
                </p>
            </div>

            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                <div class="text-center p-6">
                    <div class="text-5xl mb-4">🔍</div>
                    <h3 class="heading-3 mb-3">Interprétabilité de l'IA</h3>
                    <p class="body-text text-gray-600 dark:text-gray-400">
                        Développement de méthodes pour comprendre et expliquer
                        les décisions des modèles complexes
                    </p>
                </div>

                <div class="text-center p-6">
                    <div class="text-5xl mb-4">📈</div>
                    <h3 class="heading-3 mb-3">Optimisation Stochastique</h3>
                    <p class="body-text text-gray-600 dark:text-gray-400">
                        Application des méthodes probabilistes pour
                        l'optimisation de modèles d'apprentissage
                    </p>
                </div>

                <div class="text-center p-6">
                    <div class="text-5xl mb-4">🎯</div>
                    <h3 class="heading-3 mb-3">Robustesse des Modèles</h3>
                    <p class="body-text text-gray-600 dark:text-gray-400">
                        Conception de systèmes IA résistants aux perturbations
                        et aux attaques adverses
                    </p>
                </div>

                <div class="text-center p-6">
                    <div class="text-5xl mb-4">📊</div>
                    <h3 class="heading-3 mb-3">Analyse de Données Complexes</h3>
                    <p class="body-text text-gray-600 dark:text-gray-400">
                        Traitement et modélisation de données hétérogènes et de
                        grande dimension
                    </p>
                </div>

                <div class="text-center p-6">
                    <div class="text-5xl mb-4">🔬</div>
                    <h3 class="heading-3 mb-3">Recherche Appliquée</h3>
                    <p class="body-text text-gray-600 dark:text-gray-400">
                        Pont entre théorie mathématique et applications
                        industrielles de l'IA
                    </p>
                </div>

                <div class="text-center p-6">
                    <div class="text-5xl mb-4">⚡</div>
                    <h3 class="heading-3 mb-3">Optimisation de Performance</h3>
                    <p class="body-text text-gray-600 dark:text-gray-400">
                        Amélioration de l'efficacité computationnelle des
                        algorithmes d'apprentissage
                    </p>
                </div>
            </div>
        </section>

        <!-- Soft Skills -->
        <section class="bg-gray-50 dark:bg-gray-900/50 py-16">
            <div class="container">
                <div class="text-center mb-12">
                    <h2 class="heading-2 mb-4">Compétences Transversales</h2>
                    <p
                        class="body-large max-w-2xl mx-auto text-gray-600 dark:text-gray-400"
                    >
                        Au-delà de la technique, les qualités humaines qui font
                        la différence
                    </p>
                </div>

                <div
                    class="grid gap-8 md:grid-cols-2 lg:grid-cols-4 max-w-6xl mx-auto"
                >
                    <div class="text-center">
                        <div
                            class="w-16 h-16 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-full flex items-center justify-center text-2xl mx-auto mb-4"
                        >
                            🧠
                        </div>
                        <h3 class="heading-3 mb-2">Pensée Analytique</h3>
                        <p class="body-text text-sm">
                            Capacité à décomposer des problèmes complexes en
                            éléments analysables
                        </p>
                    </div>

                    <div class="text-center">
                        <div
                            class="w-16 h-16 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded-full flex items-center justify-center text-2xl mx-auto mb-4"
                        >
                            🚀
                        </div>
                        <h3 class="heading-3 mb-2">Innovation</h3>
                        <p class="body-text text-sm">
                            Recherche constante de nouvelles approches et
                            solutions créatives
                        </p>
                    </div>

                    <div class="text-center">
                        <div
                            class="w-16 h-16 bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 rounded-full flex items-center justify-center text-2xl mx-auto mb-4"
                        >
                            🤝
                        </div>
                        <h3 class="heading-3 mb-2">Collaboration</h3>
                        <p class="body-text text-sm">
                            Travail efficace en équipe multidisciplinaire et
                            communication claire
                        </p>
                    </div>

                    <div class="text-center">
                        <div
                            class="w-16 h-16 bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 rounded-full flex items-center justify-center text-2xl mx-auto mb-4"
                        >
                            📚
                        </div>
                        <h3 class="heading-3 mb-2">Apprentissage Continu</h3>
                        <p class="body-text text-sm">
                            Curiosité intellectuelle et adaptation rapide aux
                            nouvelles technologies
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>
