---
import DossierPage from "../../../../views/DossierPage.astro";
import { dossiers } from "../../../../data/dossiers";

export function getStaticPaths() {
	return dossiers.map((dossier) => ({
		params: { slug: dossier.slug },
		props: { dossier },
	}));
}

const { dossier } = Astro.props;
---

<DossierPage dossier={dossier} lang="fr" />
