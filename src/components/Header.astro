---
import {
  getRoutePath,
  languages,
  localizePath,
  useTranslations,
  type Lang,
} from "../i18n/utils";

interface Props {
  lang: Lang;
  /** URL of this page in each language (from Layout) */
  langPaths: Record<Lang, string>;
}

const { lang, langPaths } = Astro.props;
const t = useTranslations(lang);
const routePath = getRoutePath(Astro.url);

// `section` is the route prefix that marks the item as active
const navItems = [
  { name: t("nav.resume"), href: localizePath("#about", lang), section: "/" },
  { name: t("nav.projects"), href: localizePath("projects", lang), section: "/projects" },
  { name: t("nav.blog"), href: localizePath("blog", lang), section: "/blog" },
];

const isActive = (section: string) =>
  section === "/" ? routePath === "/" : routePath.startsWith(section);
---

<header
  class="sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70"
>
  <div class="container-custom flex h-14 items-center justify-between gap-4">
    <a
      href={localizePath("", lang)}
      class="flex items-center gap-2.5 text-sm font-semibold tracking-tight text-fg"
    >
      <img
        src={`${import.meta.env.BASE_URL}logo.jpg`}
        alt=""
        width="28"
        height="28"
        class="h-7 w-7 rounded-full object-cover"
      />
      <span>Léonel Vodounou</span>
    </a>

    <div class="flex items-center gap-1">
      <nav class="mr-2 hidden items-center gap-1 sm:flex">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.section) ? "page" : undefined}
              class:list={[
                "rounded-md px-3 py-1.5 text-sm transition-colors",
                isActive(item.section)
                  ? "font-medium text-fg"
                  : "text-fg-muted hover:text-fg",
              ]}
            >
              {item.name}
            </a>
          ))
        }
      </nav>

      <!-- Language switch: links to this same page in the other language -->
      <nav
        id="lang-switch"
        aria-label={t("nav.language")}
        class="flex items-center rounded-md border border-border p-0.5 text-xs font-medium"
      >
        {
          (Object.keys(languages) as Lang[]).map((l) =>
            l === lang ? (
              <span aria-current="true" class="rounded bg-muted px-2 py-1 text-fg">
                {t(`lang.${l}`)}
              </span>
            ) : (
              <a
                href={langPaths[l]}
                hreflang={l}
                lang={l}
                title={languages[l]}
                class="rounded px-2 py-1 text-fg-subtle hover:text-fg"
              >
                {t(`lang.${l}`)}
              </a>
            ),
          )
        }
      </nav>

      <button
        id="theme-toggle"
        type="button"
        class="ml-1 rounded-md p-2 text-fg-muted transition-colors hover:bg-muted hover:text-fg"
        aria-label={t("nav.theme")}
      >
        <svg class="h-4 w-4 dark:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"></path>
        </svg>
        <svg class="hidden h-4 w-4 dark:block" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"></path>
        </svg>
      </button>

      <button
        id="mobile-menu-btn"
        type="button"
        class="rounded-md p-2 text-fg-muted hover:bg-muted hover:text-fg sm:hidden"
        aria-label={t("nav.menu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 7.5h16.5M3.75 12h16.5m-16.5 4.5h16.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-border sm:hidden">
    <div class="container-custom flex flex-col py-2">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.section) ? "page" : undefined}
            class:list={[
              "mobile-menu-link rounded-md px-2 py-2.5 text-base",
              isActive(item.section) ? "font-medium text-fg" : "text-fg-muted",
            ]}
          >
            {item.name}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {}
  });

  const menuBtn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  menuBtn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    menuBtn.setAttribute("aria-expanded", String(open));
  });
  document.querySelectorAll(".mobile-menu-link").forEach((link) =>
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      menuBtn?.setAttribute("aria-expanded", "false");
    }),
  );
</script>
