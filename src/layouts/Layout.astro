---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Starfield from "../components/Starfield.astro";
import {
    getLangFromUrl,
    getRoutePath,
    languages,
    localizePath,
    useTranslations,
    type Lang,
} from "../i18n/utils";

export interface Props {
    title: string;
    description?: string;
    image?: string;
    type?: "website" | "article";
    /** Page language. Defaults to the language implied by the URL. */
    lang?: Lang;
    /**
     * Pages with no translation (articles) pass, per language, where the
     * language switch should lead instead. Omitted for translated pages.
     */
    fallbackPaths?: Record<Lang, string>;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
    title,
    description = t("site.description"),
    image = `${import.meta.env.BASE_URL}images/og-image.jpg`,
    type = "website",
    fallbackPaths,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Where each language version of this page lives
const routePath = getRoutePath(Astro.url);
const langPaths = Object.fromEntries(
    (Object.keys(languages) as Lang[]).map((l) => [
        l,
        fallbackPaths?.[l] ?? localizePath(routePath, l),
    ]),
) as Record<Lang, string>;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="google-site-verification" content="pFgLPnIbNaB1tYL40b0RW8TiiRhktaqMcsLvMFC6y0E" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link
            rel="icon"
            type="image/svg+xml"
            href={`${import.meta.env.BASE_URL}favicon.svg`}
        />
        <meta name="generator" content={Astro.generator} />

        <!-- KaTeX Math Rendering -->
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
            crossorigin="anonymous"
        />

        <!-- Canonical URL -->
        <link rel="canonical" href={canonicalURL} />

        <!-- Language alternates (only for pages that exist in every language) -->
        {
            !fallbackPaths &&
                (Object.keys(languages) as Lang[]).map((l) => (
                    <link
                        rel="alternate"
                        hreflang={l}
                        href={new URL(langPaths[l], Astro.site)}
                    />
                ))
        }
        {
            !fallbackPaths && (
                <link
                    rel="alternate"
                    hreflang="x-default"
                    href={new URL(langPaths.en, Astro.site)}
                />
            )
        }

        <!-- Primary Meta Tags -->
        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content={type} />
        <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, Astro.url)} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={new URL(image, Astro.url)} />
        <!-- Theme Script -->
        <script is:inline>
            const theme = (() => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    return "dark";
                }
                return "light";
            })();

            if (theme === "dark") {
                document.documentElement.classList.add("dark");
            } else {
                document.documentElement.classList.remove("dark");
            }

            window.localStorage.setItem("theme", theme);
        </script>
    </head>

    <body class="antialiased flex flex-col min-h-screen relative">
        <!-- Content -->
        <div class="relative z-10 flex flex-col min-h-screen">
            <Header lang={lang} langPaths={langPaths} />

            <main class="flex-grow pt-20">
                <slot />
            </main>

            <Footer lang={lang} />
        </div>
    </body>
</html>
