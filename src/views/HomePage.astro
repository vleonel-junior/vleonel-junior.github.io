---
import Layout from "../layouts/Layout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import {
	formatDate,
	localizePath,
	period,
	tag,
	tr,
	useTranslations,
	withBase,
	type Lang,
} from "../i18n/utils";
import { chaptersFor, postsFor, postUrl } from "../i18n/content";
import { experienceData } from "../data/experience";
import { academicProjects, personalProjects } from "../data/projects";
import { certificationsData } from "../data/certifications";
import { educationData } from "../data/education";
import { publicationsData } from "../data/publications";
import { volunteeringData } from "../data/volunteering";
import { dossiers } from "../data/dossiers";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Latest articles, in this language when translated
const latestPosts = (await postsFor(lang)).slice(0, 3);

// Published chapters per reading-notes series
const featuredDossiers = await Promise.all(
	dossiers.map(async (d) => ({
		...d,
		published: (await chaptersFor(d.slug, lang)).length,
	})),
);

const projects = [...academicProjects, ...personalProjects].sort(
	(a, b) => Number(b.year ?? 0) - Number(a.year ?? 0),
);
const base = import.meta.env.BASE_URL;
---

<Layout title={t("site.title")} description={t("site.description")} lang={lang}>
	<div class="mx-auto w-full max-w-3xl px-4 sm:px-6">
		<!-- Hero -->
		<section id="about" class="scroll-mt-20 pb-16 pt-16 sm:pt-24">
			<img
				src={`${base}images/me_cropped.png`}
				alt="Léonel Vodounou"
				width="72"
				height="72"
				class="mb-6 h-18 w-18 rounded-full border border-border object-cover object-[center_35%]"
			/>
			<h1 class="text-3xl font-semibold tracking-tight text-fg sm:text-4xl">
				Léonel Vodounou
			</h1>
			<p class="mt-2 text-base text-fg-muted">
				{t("hero.kicker")} · {t("home.location")}
			</p>
			<p class="mt-6 max-w-2xl text-lg leading-relaxed text-fg-muted">
				{t("hero.tagline")}
			</p>

			<div class="mt-8 flex flex-wrap gap-3">
				<a href={`${base}cv_leonel_vodounou.pdf`} target="_blank" class="btn-primary">
					{t("hero.cv")}
				</a>
				<a href="#writing" class="btn-secondary">{t("hero.notes")}</a>
				<a href="https://github.com/vleonel-junior" target="_blank" rel="noopener" class="btn-secondary">
					GitHub
				</a>
			</div>

			<div class="mt-12 space-y-4 text-[1.0625rem] leading-relaxed text-fg-muted [&_strong]:font-medium [&_strong]:text-fg">
				<p set:html={t("home.bio.1")} />
				<p set:html={t("home.bio.2")} />
				<p set:html={t("home.bio.3")} />
			</div>
		</section>

		<!-- Writing -->
		<section id="writing" class="scroll-mt-20 border-t border-border py-14">
			<SectionTitle title={t("home.writing")} />

			{
				featuredDossiers.map((d) => (
					<a
						href={localizePath(`blog/dossier/${d.slug}/`, lang)}
						class="card group mb-4 flex gap-5 p-5"
					>
						{d.cover && (
							<img
								src={withBase(d.cover)}
								alt=""
								width="72"
								height="96"
								class="h-24 w-[4.5rem] flex-shrink-0 rounded-md border border-border object-cover"
								loading="lazy"
							/>
						)}
						<div class="min-w-0">
							<p class="eyebrow">
								{t("home.series")} · {d.published}/{d.totalChapters} {t("home.chapters")}
							</p>
							<h3 class="mt-1.5 text-base font-semibold text-fg group-hover:text-accent">
								{d.title}
							</h3>
							<p class="mt-1 line-clamp-2 text-sm leading-relaxed text-fg-muted">
								{tr(d.description, lang)}
							</p>
							<div
								class="mt-3 h-1 w-full max-w-48 overflow-hidden rounded-full bg-muted"
								aria-hidden="true"
							>
								<div
									class="h-full rounded-full bg-accent"
									style={`width: ${(d.published / d.totalChapters) * 100}%`}
								/>
							</div>
						</div>
					</a>
				))
			}

			<ul class="divide-y divide-border">
				{
					latestPosts.map((post) => (
						<li>
							<a
								href={postUrl(post)}
								class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-6"
							>
								<time
									datetime={post.data.pubDate.toISOString()}
									class="w-28 flex-shrink-0 text-sm tabular-nums text-fg-subtle"
								>
									{formatDate(post.data.pubDate, lang, "short")}
								</time>
								<div class="min-w-0">
									<h3
										lang={post.data.lang}
										class="text-base font-medium text-fg group-hover:text-accent"
									>
										{post.data.title}
										{post.data.lang !== lang && (
											<span class="tag ml-2 align-middle" title={t(`lang.writtenIn.${post.data.lang}`)}>
												{t(`lang.${post.data.lang}`)}
											</span>
										)}
									</h3>
									<p lang={post.data.lang} class="mt-1 line-clamp-2 text-sm leading-relaxed text-fg-muted">
										{post.data.description}
									</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>

			<a href={localizePath("blog", lang)} class="link mt-4 inline-block text-sm">
				{t("home.allArticles")}
			</a>
		</section>

		<!-- Experience -->
		<section class="border-t border-border py-14">
			<SectionTitle title={t("home.experience")} />
			<ol class="space-y-8">
				{
					experienceData.map((exp) => (
						<li class="grid gap-1 sm:grid-cols-[7rem_1fr] sm:gap-6">
							<p class="text-sm tabular-nums text-fg-subtle">
								{period(exp.startDate, exp.endDate, lang)}
							</p>
							<div>
								<h3 class="text-base font-semibold text-fg">{tr(exp.role, lang)}</h3>
								<p class="text-sm text-fg-subtle">{tr(exp.company, lang)}</p>
								<p class="mt-2 text-[0.9375rem] leading-relaxed text-fg-muted">
									{tr(exp.description, lang)}
								</p>
								<div class="mt-3 flex flex-wrap gap-1.5">
									{exp.technologies.map((tech) => (
										<span class="tag">{tag(tech, lang)}</span>
									))}
								</div>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<!-- Projects -->
		<section id="projects" class="scroll-mt-20 border-t border-border py-14">
			<SectionTitle title={t("home.projects")} />
			<div class="grid gap-4 sm:grid-cols-2">
				{
					projects.map((project) => (
						<a
							href={project.githubUrl ?? project.liveUrl ?? localizePath("projects", lang)}
							target={project.githubUrl || project.liveUrl ? "_blank" : undefined}
							rel="noopener"
							class="card group flex flex-col p-5"
						>
							<div class="flex items-baseline justify-between gap-3">
								<h3 class="text-base font-semibold text-fg group-hover:text-accent">
									{tr(project.title, lang)}
								</h3>
								{project.year && (
									<span class="text-sm tabular-nums text-fg-subtle">{project.year}</span>
								)}
							</div>
							<p class="mt-2 line-clamp-4 flex-grow text-sm leading-relaxed text-fg-muted">
								{tr(project.description, lang)}
							</p>
							<div class="mt-4 flex flex-wrap gap-1.5">
								{project.technologies.map((tech) => (
									<span class="tag">{tag(tech, lang)}</span>
								))}
							</div>
						</a>
					))
				}
			</div>
			<a href={localizePath("projects", lang)} class="link mt-6 inline-block text-sm">
				{t("home.allProjects")} →
			</a>
		</section>

		<!-- Education -->
		<section class="border-t border-border py-14">
			<SectionTitle title={t("home.education")} />
			<ol class="space-y-6">
				{
					educationData.map((edu) => (
						<li class="grid gap-1 sm:grid-cols-[7rem_1fr] sm:gap-6">
							<p class="text-sm tabular-nums text-fg-subtle">{edu.year}</p>
							<div>
								<h3 class="text-base font-semibold text-fg">{tr(edu.degree, lang)}</h3>
								<p class="text-sm text-fg-subtle">{tr(edu.institution, lang)}</p>
								{edu.description && (
									<p class="mt-1.5 text-[0.9375rem] leading-relaxed text-fg-muted">
										{tr(edu.description, lang)}
									</p>
								)}
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<!-- Publications (hidden while empty) -->
		{
			publicationsData.length > 0 && (
				<section class="border-t border-border py-14">
					<SectionTitle title={t("home.publications")} />
					<ul class="space-y-4">
						{publicationsData.map((pub) => (
							<li class="grid gap-1 sm:grid-cols-[7rem_1fr] sm:gap-6">
								<p class="text-sm tabular-nums text-fg-subtle">{pub.year}</p>
								<div>
									{pub.url ? (
										<a href={pub.url} target="_blank" class="font-medium text-fg hover:text-accent">
											{pub.title}
										</a>
									) : (
										<span class="font-medium text-fg">{pub.title}</span>
									)}
									<p class="text-sm text-fg-subtle">
										{[pub.authors, pub.journal].filter(Boolean).join(" · ")}
									</p>
								</div>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<!-- Certifications -->
		<section class="border-t border-border py-14">
			<SectionTitle title={t("home.certifications")} />
			<div class="grid gap-4 sm:grid-cols-2">
				{
					certificationsData.map((cert) => {
						const href = cert.url || (cert.image ? withBase(cert.image) : undefined);
						const Tag = href ? "a" : "div";
						return (
							<Tag
								href={href}
								target={href ? "_blank" : undefined}
								class="card group flex flex-col overflow-hidden"
							>
								{cert.image && (
									<div class="aspect-[16/9] overflow-hidden border-b border-border bg-muted">
										<img
											src={withBase(cert.image)}
											alt={tr(cert.title, lang)}
											class="h-full w-full object-cover object-top"
											loading="lazy"
										/>
									</div>
								)}
								<div class="flex flex-grow flex-col p-5">
									<div class="flex items-baseline justify-between gap-3">
										<h3 class="text-base font-semibold text-fg group-hover:text-accent">
											{tr(cert.title, lang)}
										</h3>
										<span class="text-sm tabular-nums text-fg-subtle">{cert.date}</span>
									</div>
									<p class="text-sm text-fg-subtle">{cert.issuer}</p>
									{cert.description && (
										<p class="mt-2 text-sm leading-relaxed text-fg-muted">
											{tr(cert.description, lang)}
										</p>
									)}
								</div>
							</Tag>
						);
					})
				}
			</div>
		</section>

		<!-- Volunteering / Teaching -->
		<section class="border-t border-border py-14">
			<SectionTitle title={t("home.volunteering")} />
			<ol class="space-y-6">
				{
					volunteeringData.map((vol) => (
						<li class="grid gap-1 sm:grid-cols-[7rem_1fr] sm:gap-6">
							<p class="text-sm tabular-nums text-fg-subtle">{vol.period}</p>
							<div>
								<h3 class="text-base font-semibold text-fg">{tr(vol.role, lang)}</h3>
								<p class="text-sm text-fg-subtle">{tr(vol.organization, lang)}</p>
								<p class="mt-1.5 text-[0.9375rem] leading-relaxed text-fg-muted">
									{tr(vol.description, lang)}
								</p>
							</div>
						</li>
					))
				}
			</ol>
		</section>
	</div>
</Layout>
