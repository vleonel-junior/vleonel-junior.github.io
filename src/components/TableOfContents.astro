---
// Reading map in the style of Substack: one short line per heading, pinned to
// the left edge. Hovering or clicking it opens the table of contents, and the
// line of the section being read is highlighted as you scroll. On narrow
// screens it becomes a small floating "Contents" button.
import type { MarkdownHeading } from "astro";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
    headings: MarkdownHeading[];
    lang: Lang;
}

const { headings, lang } = Astro.props;
const t = useTranslations(lang);

// Top level is the shallowest heading used (usually h2)
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
const top = Math.min(...items.map((h) => h.depth));
// Space between lines: 12px like Substack, tighter for long articles so the
// whole map stays within about 70% of the screen height
const gap = Math.max(3, Math.min(12, Math.floor(520 / items.length) - 2));
---

{
    items.length > 1 && (
        <div class="reading-map" data-reading-map>
            <button
                type="button"
                class="reading-map-trigger"
                aria-label={t("toc.title")}
                aria-expanded="false"
                aria-controls="reading-map-panel"
                style={`--gap: ${gap}px`}
            >
                {items.map((h) => (
                    <span class={`reading-map-line indent-${h.depth - top}`} data-line={h.slug} />
                ))}
            </button>

            <button
                type="button"
                class="reading-map-fab"
                aria-label={t("toc.title")}
                aria-expanded="false"
                aria-controls="reading-map-panel"
            >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 6h16M4 12h10M4 18h6" />
                </svg>
                {t("toc.title")}
            </button>

            <nav id="reading-map-panel" class="reading-map-panel" aria-label={t("toc.title")}>
                <p class="reading-map-title">{t("toc.title")}</p>
                <ul>
                    {items.map((h) => (
                        <li>
                            <a
                                href={`#${h.slug}`}
                                class={`reading-map-link indent-${h.depth - top}`}
                                data-link={h.slug}
                                title={h.text}
                            >
                                {h.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </div>
    )
}

<script>
    function initReadingMap() {
        const root = document.querySelector<HTMLElement>("[data-reading-map]");
        if (!root) return;
        const triggers = root.querySelectorAll<HTMLButtonElement>(".reading-map-trigger, .reading-map-fab");
        const panel = root.querySelector<HTMLElement>(".reading-map-panel");
        const lines = root.querySelectorAll<HTMLElement>("[data-line]");
        const links = root.querySelectorAll<HTMLAnchorElement>("[data-link]");
        const headings = [...lines]
            .map((l) => document.getElementById(l.dataset.line!))
            .filter((h): h is HTMLElement => !!h);

        // --- Open / close ---
        let pinned = false;
        let closeTimer: number | undefined;
        const setOpen = (open: boolean) => {
            root.classList.toggle("is-open", open);
            triggers.forEach((b) => b.setAttribute("aria-expanded", String(open)));
            // Long contents lists open on the section being read
            const active = panel?.querySelector<HTMLElement>(".is-active");
            if (open && panel && active) {
                panel.scrollTop = active.offsetTop - panel.clientHeight / 2 + active.offsetHeight / 2;
            }
        };
        const hoverCapable = window.matchMedia("(hover: hover)").matches;

        triggers.forEach((b) =>
            b.addEventListener("click", () => {
                pinned = !root.classList.contains("is-open") || !pinned;
                setOpen(pinned);
            }),
        );
        if (hoverCapable) {
            root.addEventListener("mouseenter", () => {
                clearTimeout(closeTimer);
                setOpen(true);
            });
            root.addEventListener("mouseleave", () => {
                if (pinned) return;
                closeTimer = window.setTimeout(() => setOpen(false), 150);
            });
        }
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                pinned = false;
                setOpen(false);
            }
        });
        document.addEventListener("click", (e) => {
            if (!root.contains(e.target as Node)) {
                pinned = false;
                setOpen(false);
            }
        });
        links.forEach((a) =>
            a.addEventListener("click", () => {
                pinned = false;
                setOpen(false);
            }),
        );

        // --- Current section ---
        const setActive = (slug: string | null) => {
            lines.forEach((l) => l.classList.toggle("is-active", l.dataset.line === slug));
            links.forEach((a) => a.classList.toggle("is-active", a.dataset.link === slug));
        };
        const update = () => {
            const offset = 120;
            let current: HTMLElement | null = null;
            for (const h of headings) {
                if (h.getBoundingClientRect().top - offset <= 0) current = h;
                else break;
            }
            setActive((current ?? headings[0])?.id ?? null);
        };
        let ticking = false;
        window.addEventListener(
            "scroll",
            () => {
                if (ticking) return;
                ticking = true;
                requestAnimationFrame(() => {
                    update();
                    ticking = false;
                });
            },
            { passive: true },
        );
        update();

        panel?.addEventListener("mouseenter", () => clearTimeout(closeTimer));
    }

    initReadingMap();
</script>

<style>
    .reading-map-trigger {
        position: fixed;
        left: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        z-index: 40;
        display: none;
        flex-direction: column;
        align-items: flex-end;
        gap: var(--gap, 12px);
        padding: 0.75rem 0.5rem;
        max-height: 70vh;
        overflow: hidden;
        background: none;
        border: 0;
        cursor: pointer;
    }

    .reading-map-line {
        display: block;
        width: 12px;
        height: 1.5px;
        background: var(--fg-subtle);
        opacity: 0.8;
        transition: background-color 150ms, opacity 150ms;
    }
    .reading-map-line.indent-1 {
        width: 10px;
        opacity: 0.6;
    }
    .reading-map-line.indent-2 {
        width: 8px;
        opacity: 0.6;
    }
    .reading-map-line.is-active {
        background: var(--fg);
        opacity: 1;
    }

    .reading-map-panel {
        position: fixed;
        left: 2.75rem;
        top: 50%;
        transform: translateY(-50%) scale(0.975);
        transform-origin: left center;
        z-index: 50;
        width: 16.5rem;
        max-height: min(80vh, 40rem);
        overflow-y: auto;
        padding: 0.5rem;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        box-shadow:
            0 4px 6px -1px rgb(0 0 0 / 0.07),
            0 10px 24px -6px rgb(0 0 0 / 0.12);
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 150ms ease,
            transform 150ms ease,
            visibility 150ms;
    }
    .reading-map.is-open .reading-map-panel {
        opacity: 1;
        visibility: visible;
        transform: translateY(-50%) scale(1);
    }

    .reading-map-title {
        padding: 0.25rem 0.5rem 0.5rem;
        font-size: 0.6875rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--fg);
    }

    .reading-map-panel ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .reading-map-link {
        display: block;
        padding: 0.3rem 0.5rem;
        border-radius: 0.25rem;
        font-size: 0.9375rem;
        line-height: 1.4;
        color: var(--fg-subtle);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        text-decoration: none;
    }
    .reading-map-link.indent-1 {
        padding-left: 1.25rem;
    }
    .reading-map-link.indent-2 {
        padding-left: 2rem;
    }
    .reading-map-link:hover {
        color: var(--fg);
        background: var(--muted);
    }
    .reading-map-link.is-active {
        color: var(--fg);
    }

    /* Narrow screens: floating button + bottom sheet */
    .reading-map-fab {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        z-index: 40;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.875rem;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--fg);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 999px;
        box-shadow: 0 4px 16px rgb(0 0 0 / 0.12);
        cursor: pointer;
    }

    @media (max-width: 1023px) {
        .reading-map-panel {
            left: 0.75rem;
            right: 0.75rem;
            top: auto;
            bottom: 4rem;
            width: auto;
            max-height: 60vh;
            transform: translateY(0.5rem);
        }
        .reading-map.is-open .reading-map-panel {
            transform: translateY(0);
        }
    }

    @media (min-width: 1024px) {
        .reading-map-trigger {
            display: flex;
        }
        .reading-map-fab {
            display: none;
        }
    }
</style>
