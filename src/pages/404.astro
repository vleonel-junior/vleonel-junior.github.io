---
import Layout from "../layouts/Layout.astro";
import { localizePath, useTranslations } from "../i18n/utils";

// GitHub Pages serves one 404 for every language, so it shows both.
const en = useTranslations("en");
const fr = useTranslations("fr");
---

<Layout
    title={`${en("404.title")} | Léonel VODOUNOU`}
    lang="en"
    fallbackPaths={{ en: localizePath("", "en"), fr: localizePath("", "fr") }}
>
    <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
        <h1 class="text-6xl font-bold text-gray-800 dark:text-gray-100 mb-4">404</h1>
        <h2 class="text-2xl font-semibold text-gray-600 dark:text-gray-300 mb-2">{en("404.title")}</h2>
        <p class="text-lg text-gray-500 dark:text-gray-400 mb-6 max-w-lg">{en("404.text")}</p>
        <h2 lang="fr" class="text-2xl font-semibold text-gray-600 dark:text-gray-300 mb-2">{fr("404.title")}</h2>
        <p lang="fr" class="text-lg text-gray-500 dark:text-gray-400 mb-8 max-w-lg">{fr("404.text")}</p>
        <div class="flex flex-wrap gap-3 justify-center">
            <a href={localizePath("", "en")} class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-lg transition-colors">
                {en("404.back")}
            </a>
            <a href={localizePath("", "fr")} lang="fr" class="px-6 py-3 border border-emerald-600 text-emerald-700 dark:text-emerald-400 font-medium rounded-lg transition-colors hover:bg-emerald-600/10">
                {fr("404.back")}
            </a>
        </div>
    </div>
</Layout>

<script is:inline>
    // Script pour corriger automatiquement les anciennes URLs référencées par Google/Bing
    // qui contenaient le sous-dossier "/Portfolio-main/"
    if (window.location.pathname.startsWith("/Portfolio-main")) {
        const newUrl = window.location.pathname.replace("/Portfolio-main", "");
        window.location.replace(newUrl || "/");
    }
</script>
