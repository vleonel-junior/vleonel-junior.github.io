---
import Layout from "../layouts/Layout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { dossiers } from "../data/dossiers";
import { chaptersFor, chapterUrl, postsFor, postUrl, thumbnail } from "../i18n/content";
import {
	formatDate,
	localizePath,
	tr,
	useTranslations,
	withBase,
	type Lang,
} from "../i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Reading-notes series, with their published chapters in this language
const series = await Promise.all(
	dossiers.map(async (d) => ({ ...d, published: await chaptersFor(d.slug, lang) })),
);

// One entry per article, in this language when translated
const posts = (await postsFor(lang)).map((post) => {
	const words = post.body.split(/\s+/).length;
	return {
		post,
		readingTime: post.data.readTime ?? Math.ceil(words / 200),
		thumb: thumbnail(post),
	};
});
---

<Layout title={t("blog.title")} description={t("blog.description")} lang={lang}>
	<div class="mx-auto w-full max-w-3xl px-4 pb-8 pt-16 sm:px-6 sm:pt-24">
		<h1 class="text-3xl font-semibold tracking-tight text-fg sm:text-4xl">
			{t("blog.heading")}
		</h1>
		<p class="mt-3 text-lg text-fg-muted">{t("blog.description")}</p>

		<!-- Reading-notes series -->
		<section class="mt-14">
			<SectionTitle title={t("blog.readingNotes")} />
			{
				series.map((d) => (
					<div class="card overflow-hidden">
						<a
							href={localizePath(`blog/dossier/${d.slug}/`, lang)}
							class="group flex gap-5 p-5 sm:p-6"
						>
							{d.cover && (
								<img
									src={withBase(d.cover)}
									alt=""
									width="96"
									height="128"
									class="h-32 w-24 flex-shrink-0 rounded-md border border-border object-cover"
									loading="lazy"
								/>
							)}
							<div class="min-w-0">
								<p class="eyebrow">
									{t("blog.seriesOf", { n: d.totalChapters })} ·{" "}
									{t("blog.published", { n: d.published.length })}
								</p>
								<h2 class="mt-1.5 text-lg font-semibold text-fg group-hover:text-accent">
									{d.title}
								</h2>
								<p class="text-sm text-fg-subtle">
									{t("blog.by")} {d.bookAuthor}
								</p>
								<p class="mt-2 text-sm leading-relaxed text-fg-muted">
									{tr(d.description, lang)}
								</p>
								<div class="mt-4 flex items-center gap-3" aria-hidden="true">
									<div class="h-1 w-40 overflow-hidden rounded-full bg-muted">
										<div
											class="h-full rounded-full bg-accent"
											style={`width: ${(d.published.length / d.totalChapters) * 100}%`}
										/>
									</div>
									<span class="text-xs tabular-nums text-fg-subtle">
										{d.published.length}/{d.totalChapters}
									</span>
								</div>
							</div>
						</a>
						<ol class="divide-y divide-border border-t border-border">
							{d.published.map((c) => (
								<li>
									<a
										href={chapterUrl(c)}
										class="flex items-baseline gap-4 px-5 py-3 text-sm transition-colors hover:bg-muted sm:px-6"
									>
										<span class="w-6 flex-shrink-0 tabular-nums text-fg-subtle">
											{String(c.data.chapter).padStart(2, "0")}
										</span>
										<span class="text-fg">
											{tr(d.chapters.find((m) => m.number === c.data.chapter)?.title ?? c.data.title, lang)}
										</span>
									</a>
								</li>
							))}
						</ol>
					</div>
				))
			}
		</section>

		<!-- Articles -->
		<section class="mt-16">
			<SectionTitle title={t("blog.articles")} />
			<ul class="divide-y divide-border">
				{
					posts.map(({ post, readingTime, thumb }) => (
						<li>
							<a href={postUrl(post)} class="group flex items-start gap-5 py-6 sm:gap-8">
								<div class="min-w-0 flex-1">
									<h2
										lang={post.data.lang}
										class="text-lg font-bold leading-snug text-fg group-hover:underline group-hover:decoration-accent group-hover:underline-offset-4 sm:text-xl"
									>
										{post.data.title}
									</h2>
									<p lang={post.data.lang} class="mt-1.5 line-clamp-2 leading-snug text-fg-muted sm:text-[1.0625rem]">
										{post.data.description}
									</p>
									<p class="mt-2.5 flex flex-wrap items-center gap-x-1.5 text-xs uppercase tracking-wide text-fg-subtle">
										<time datetime={post.data.pubDate.toISOString()}>
											{formatDate(post.data.pubDate, lang, "short")}
										</time>
										<span aria-hidden="true">•</span>
										<span>
											{readingTime} {t("blog.minRead")}
										</span>
										{post.data.lang !== lang && (
											<span class="tag ml-1 normal-case" title={t(`lang.writtenIn.${post.data.lang}`)}>
												{t(`lang.${post.data.lang}`)}
											</span>
										)}
									</p>
								</div>
								{thumb && (
									<img
										src={withBase(thumb)}
										alt=""
										width="150"
										height="100"
										loading="lazy"
										class="h-16 w-24 flex-shrink-0 rounded border border-border bg-white object-cover sm:h-[100px] sm:w-[150px]"
									/>
								)}
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</Layout>
