---
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);

const links = [
  {
    label: "GitHub",
    href: "https://github.com/vleonel-junior",
    icon: "M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/leonel-vodounou",
    icon: "M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4z",
  },
  {
    label: "X",
    href: "https://x.com/leonelvodounou",
    icon: "M4 4l11.733 16h4.267l-11.733 -16zM4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772",
  },
  {
    label: "Email",
    href: "mailto:vleoneljunior@gmail.com",
    icon: "M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm18 3-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7",
  },
];
---

<footer class="mt-24 border-t border-border">
  <div
    class="container-custom flex flex-col items-center justify-between gap-4 py-8 sm:flex-row"
  >
    <p class="text-sm text-fg-subtle">
      &copy; 2026 Léonel Vodounou. {t("footer.rights")}
    </p>
    <div class="flex items-center gap-1">
      {
        links.map((l) => (
          <a
            href={l.href}
            target={l.href.startsWith("http") ? "_blank" : undefined}
            rel={l.href.startsWith("http") ? "noopener noreferrer" : undefined}
            aria-label={l.label}
            class="rounded-md p-2 text-fg-subtle transition-colors hover:bg-muted hover:text-fg"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={l.icon} />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</footer>
