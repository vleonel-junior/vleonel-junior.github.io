---
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
    lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<section class="card mb-12 p-6">
    <h3 class="text-base font-semibold text-fg">{t("newsletter.title")}</h3>
    <p class="mt-1.5 text-sm leading-relaxed text-fg-muted">{t("newsletter.text")}</p>

    <form
        action="https://buttondown.email/api/emails/embed-subscribe/Gandalf-LeGris"
        method="post"
        class="mt-4 flex flex-col gap-2 sm:flex-row"
    >
        <label for="newsletter-email" class="sr-only">Email</label>
        <input
            id="newsletter-email"
            type="email"
            name="email"
            placeholder={t("newsletter.placeholder")}
            required
            class="min-w-0 flex-1 rounded-lg border border-border bg-bg px-3 py-2 text-sm text-fg placeholder:text-fg-subtle focus:border-accent focus:outline-none"
        />
        <input type="hidden" value="1" name="embed" />
        <button type="submit" class="btn-primary">{t("newsletter.subscribe")}</button>
    </form>
    <p class="mt-3 text-xs text-fg-subtle">{t("newsletter.unsubscribe")}</p>
</section>
