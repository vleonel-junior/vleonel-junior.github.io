---
import BlogPostPage from "../../../views/BlogPostPage.astro";
import { postPaths } from "../../../i18n/content";

export async function getStaticPaths() {
    return postPaths("fr");
}

type Props = Awaited<ReturnType<typeof postPaths>>[number]["props"];
const { entry, redirectTo, langPaths, translated } = Astro.props;

// Not written in this language yet: send readers to the existing version
if (!entry) return Astro.redirect(redirectTo!);
---

<BlogPostPage post={entry} langPaths={langPaths} translated={translated} />
